{
  "extends": "@1stg/tsconfig/nodenext",
  "compilerOptions": {
    "isolatedModules": true,
    "rootDir": ".",
    "paths": {
      "synckit": [
        "./src/index.ts"
      ]
    },
    "target": "ES2020",
    "types": [
      "jest",
      "node"
    ],
    "allowJs": true
  },
  "files": [
    "register.cjs",
    "shared.cjs"
  ],
  "include": [
    "src",
    "test/**/*.ts",
    "test/**/*.mts",
    "test/**/*.cts",
    "register.d.cts"
  ]
}
